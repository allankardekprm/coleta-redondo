javascript: (function() {
    var supportData = {};
    var unitNames = [];
    
    // --- Configurações do Script ---
    var HIDE_ZERO_COLUMNS = true; // Esconde colunas de unidades com 0 apoios em todas as linhas
    var SORT_BY_POPULATION = true; // Ordena os jogadores por Pop. Total (maior para menor)
    // ---------------------------------
    
    // --- CUSTO DE POPULAÇÃO POR UNIDADE (FATOR CRÍTICO) ---
    const POP_COSTS = {
        'Lanceiro': 1,
        'Espadachim': 1,
        'Bárbaro': 1,
        'Arqueiro': 1,
        'Explorador': 2,
        'Cavalaria leve': 4,
        'Arqueiro a cavalo': 5,
        'Cavalaria pesada': 6, 
        'Aríete': 5,
        'Catapulta': 8,
        'Paladino': 1,
        'Nobre': 100,
        'Milícia': 0
    };
    // ----------------------------------------------------

    var formContainer = document.querySelector('form#withdraw_selected_units_village_info');
    
    if (!formContainer) {
        alert('Tabela de apoios (Defesas) não encontrada! Certifique-se de estar na aba Guarnição/Defesas da aldeia.');
        return;
    }
    
    var supportTable = formContainer.querySelector('table.vis');

    // 1. Coleta os nomes das unidades do cabeçalho
    var unitImages = supportTable.querySelectorAll('th img[data-title]');
    
    if (unitImages.length < 5) {
        alert('Identificação de tropas incompleta. O script pode precisar de mais ajustes.');
        return;
    }

    unitImages.forEach(function(img) {
        unitNames.push(img.getAttribute('data-title').trim());
    });
    
    // 2. Coleta os dados de cada linha de apoio e CALCULA A POPULAÇÃO
    var rows = supportTable.querySelectorAll('tbody tr');
    
    rows.forEach(function(row) {
        var cells = row.cells;
        
        if (!cells[0]) {
            return;
        }
        var firstCellText = cells[0].innerText.trim();
        
        // Filtro de linhas indesejadas
        if (firstCellText.includes('Desta aldeia') || firstCellText === 'Origem') {
            return; 
        }
        
        var playerLink = cells[0].querySelector('a[href*="screen=info_player"]');
        var playerName = firstCellText; 
        
        if (playerLink) {
            playerName = playerLink.innerText.trim();
        }

        if (!supportData[playerName]) {
            supportData[playerName] = { totalPop: 0, units: {} }; 
            unitNames.forEach(unit => supportData[playerName].units[unit] = 0);
        }

        for (var j = 0; j < unitNames.length; j++) {
            var unit = unitNames[j];
            var cellIndex = j + 1; 
            
            if (cells[cellIndex]) {
                var count = parseInt(cells[cellIndex].getAttribute('data-unit-count')) || parseInt(cells[cellIndex].innerText.trim().replace(/\./g, '')) || 0;
                
                var popCost = POP_COSTS[unit] || 1; 
                var totalUnitPop = count * popCost;

                supportData[playerName].units[unit] += count; 
                supportData[playerName].totalPop += totalUnitPop; 
            }
        }
    });

    // 3. Pós-processamento e filtragem de colunas
    var finalUnitNames = [...unitNames]; 
    if (HIDE_ZERO_COLUMNS) {
        let unitsWithAnySupport = new Set();
        for (let player in supportData) {
            for (let unit of unitNames) {
                if (supportData[player].units[unit] > 0) {
                    unitsWithAnySupport.add(unit);
                }
            }
        }
        finalUnitNames = unitNames.filter(unit => unitsWithAnySupport.has(unit));
    }

    // 4. Ordena os jogadores, se solicitado
    var sortedPlayers = Object.keys(supportData);
    if (SORT_BY_POPULATION) {
        sortedPlayers.sort((a, b) => supportData[b].totalPop - supportData[a].totalPop);
    }


    // 5. Formata o resultado em HTML TABLE
    var grandTotal = 0;
    
    var outputHtml = '<h3 style="margin-top: 15px;">APOIOS DETALHADOS POR JOGADOR (População Calculada)</h3>';
    outputHtml += '<table class="vis" style="width: 100%;">';
    
    // Cabeçalho
    outputHtml += '<thead><tr>';
    outputHtml += '<th>JOGADOR</th>';
    outputHtml += '<th>POP. TOTAL</th>';
    finalUnitNames.forEach(function(unit) {
        // Tenta usar a imagem da unidade original, se possível, para o visual ser idêntico
        let unitHeader = unit;
        let originalHeaderCell = supportTable.querySelector('th img[data-title="' + unit + '"]');
        if (originalHeaderCell) {
            unitHeader = originalHeaderCell.outerHTML;
        } else {
            // Fallback para o nome
            unitHeader = unit;
        }
        outputHtml += '<th style="text-align: center;">' + unitHeader + '</th>';
    });
    outputHtml += '</tr></thead>';

    // Corpo da tabela
    outputHtml += '<tbody>';
    sortedPlayers.forEach(function(player) {
        var data = supportData[player];
        
        outputHtml += '<tr>';
        outputHtml += '<td>' + player + '</td>';
        outputHtml += '<td style="text-align: right; font-weight: bold;">' + data.totalPop.toLocaleString('pt-BR') + '</td>';
        
        finalUnitNames.forEach(function(unit) {
            let count = data.units[unit] || 0;
            outputHtml += '<td style="text-align: right;">' + count.toLocaleString('pt-BR') + '</td>';
        });
        
        outputHtml += '</tr>';
        grandTotal += data.totalPop;
    });
    outputHtml += '</tbody>';

    // Total Geral
    outputHtml += '<tfoot><tr>';
    outputHtml += '<th>TOTAL GERAL</th>';
    outputHtml += '<th style="text-align: right;">' + grandTotal.toLocaleString('pt-BR') + '</th>';
    // Colunas restantes do Total Geral (unidades)
    finalUnitNames.forEach(function() {
        outputHtml += '<th></th>'; // Células vazias (se precisar de uma soma aqui, é fácil adicionar)
    });
    outputHtml += '</tr></tfoot>';
    
    outputHtml += '</table>';

    // 6. Insere o HTML na página
    var outputDiv = document.createElement('div');
    outputDiv.innerHTML = outputHtml;

    var defesasTable = document.querySelector('form#withdraw_selected_units_village_info');
    if (defesasTable) {
        defesasTable.before(outputDiv);
    } else { 
        document.querySelector('#content_value').prepend(outputDiv);
    }
    
    // Notificação e destaque da nova tabela
    alert('A tabela de Apoios Consolidada e Formatada foi inserida acima da tabela original.\n\nClique OK e role para cima para visualizar.');

})();
